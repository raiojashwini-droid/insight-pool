# -------------------------------------------------------------
# Phase 3 Groundwork: Jira Integration
# -------------------------------------------------------------
# Host URL of your Jira Cloud instance (e.g. https://yourcompany.atlassian.net)
JIRA_HOST=https://yourcompany.atlassian.net
# Atlassian account email address
JIRA_EMAIL=admin@yourcompany.com
# Jira Cloud API Token (generated from https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=your_jira_api_token
# Default project key to filter issues (e.g. PROJ)
JIRA_PROJECT_KEY=PROJ
# Secret key for validating incoming Jira webhook signatures (HMAC SHA-256)
JIRA_WEBHOOK_SECRET=your_jira_webhook_secret

# -------------------------------------------------------------
# Phase 3 Groundwork: ClickUp Integration
# -------------------------------------------------------------
# ClickUp Personal API Token (generated in ClickUp Settings -> Apps -> API Token)
CLICKUP_API_TOKEN=pk_your_clickup_api_token
# ClickUp Team / Workspace ID (numeric string)
CLICKUP_TEAM_ID=12345678
# Optional: Specific ClickUp List ID to fetch tasks from
CLICKUP_LIST_ID=
# Secret key for validating incoming ClickUp webhook signatures (HMAC SHA-256)
CLICKUP_WEBHOOK_SECRET=your_clickup_webhook_secret
